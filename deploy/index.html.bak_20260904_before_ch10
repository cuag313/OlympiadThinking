<tr><td style="background:#eaf2f8"><b>6</b></td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">7</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">8</td><td style="color:#999">9</td><td style="color:#999">10</td><td style="color:#999">11</td><td style="color:#999">12</td></tr>
