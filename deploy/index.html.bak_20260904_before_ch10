<tr><td style="border:1px solid #ddd;padding:6px 10px;text-align:center">女生</td><td style="border:1px solid #ddd;padding:6px 10px;text-align:center">13</td><td style="border:1px solid #ddd;padding:6px 10px;text-align:center">5</td><td style="border:1px solid #ddd;padding:6px 10px;text-align:center">18</td></tr>
