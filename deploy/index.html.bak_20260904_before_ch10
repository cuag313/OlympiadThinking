<tr><td style="background:#eaf2f8"><b>3</b></td><td style="color:#999">4</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">5</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">6</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">7</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">8</td><td style="color:#999">9</td></tr>
<tr><td style="background:#eaf2f8"><b>4</b></td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">5</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">6</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">7</td><td style="background:#d5f5e3;color:#27ae60;font-weight:bold">8</td><td style="color:#999">9</td><td style="color:#999">10</td></tr>
